// PTU -> Foundry spillover on backend 4: three customer questions, answered from telemetry.
//
// Run these in the Log Analytics WORKSPACE (workspace-<suffix>, shown by the notebook): Azure portal > Log Analytics
// workspaces > your workspace > Logs. Select one query at a time and press Run. Widen the 2h window if you ran the demo earlier.
//
// The test (phase 4 of invoke-lab.ps1) sends small requests through APIM to backend 4's gpt-5-mini-ptu deployment while
// other callers saturate that PTU directly. Every request under test has an ID that starts with "spill-". The gateway policy
// writes one "routing-attempt-complete" trace per APIM attempt at a backend, and records Foundry's response headers:
//   x-ms-spillover-from-deployment  the PTU deployment the request was spilled over from
//   x-ms-spillover-error            the status code the PTU deployment returned, which is what triggered the spillover
//   x-ms-deployment-name            the deployment that actually answered (returned only when spillover happened)

// 0. Scorecard: the three answers in one row.
//    PtuReturned429      = 1. the provisioned deployment was exhausted and rejected the request with a 429
//    ServedBySpillover   = 2. the request was answered by the standard (spillover) deployment
//    ApimRetries / Apim429s = 3. APIM made one attempt, never saw a 429, and never retried: Foundry handled it
AppTraces
| where TimeGenerated > ago(10m)
| where Message == "routing-attempt-complete"
| where tostring(Properties["client_request_id"]) startswith "spill-"
| summarize
    Requests = count(),
    PtuReturned429 = countif(tostring(Properties["spillover_error"]) == "429"),
    ServedBySpillover = countif(tostring(Properties["served_deployment"]) == "gpt-5-mini-ptu-spillover"),
    CallerGot200 = countif(tostring(Properties["status_code"]) == "200"),
    Apim429s = countif(tostring(Properties["status_code"]) == "429"),
    ApimRetries = countif(toint(Properties["attempt"]) > 1)

// 1a. The PTU was exhausted. Per request, Foundry reports that the provisioned deployment returned 429.
//     This header is the authoritative proof: it comes from the service, per request.
AppTraces
| where TimeGenerated > ago(10m)
| where Message == "routing-attempt-complete"
| where tostring(Properties["client_request_id"]) startswith "spill-"
| where tostring(Properties["spillover_from"]) != "none"
| summarize Requests = count() by
    PtuDeployment = tostring(Properties["spillover_from"]),
    PtuReturnedStatus = tostring(Properties["spillover_error"])

// 1b. The PTU was exhausted. Azure Monitor platform metrics for the backend 4 account, per minute.
//     Expect a burst of 4xx rejections while the PTU is saturated and quiet minutes before and after.
//     Note: the legacy utilization metric (deprecated) rose above 100% in this lab, but the recommended V2 metric peaked
//     lower, so use the per-request evidence in 1a and the rejection counts here as the proof of exhaustion.
AzureMetrics
| where TimeGenerated > ago(10m)
| where ResourceProvider == "MICROSOFT.COGNITIVESERVICES"
| where Resource contains "ROUTE-BACKEND-4"
| where MetricName in ("AzureOpenAIProvisionedManagedUtilization", "AzureOpenAIProvisionedManagedUtilizationV2", "ClientErrors", "AzureOpenAIRequests")
| summarize
    LegacyUtilizationMaxPercent = round(maxif(Maximum, MetricName == "AzureOpenAIProvisionedManagedUtilization"), 1),
    V2UtilizationMaxPercent = round(maxif(Maximum, MetricName == "AzureOpenAIProvisionedManagedUtilizationV2"), 1),
    Requests = sumif(Total, MetricName == "AzureOpenAIRequests"),
    Rejected4xx = sumif(Total, MetricName == "ClientErrors")
    by bin(TimeGenerated, 1m)
| order by TimeGenerated asc

// 2a. The requests were served by the spillover deployment, not the PTU.
//     Foundry returns x-ms-deployment-name only when spillover happened, so "not-reported" means the PTU answered.
AppTraces
| where TimeGenerated > ago(10m)
| where Message == "routing-attempt-complete"
| where tostring(Properties["client_request_id"]) startswith "spill-"
| summarize Requests = count() by
    ServedBy = iff(tostring(Properties["served_deployment"]) == "not-reported", "gpt-5-mini-ptu (the PTU itself)", tostring(Properties["served_deployment"])),
    StatusReturnedToCaller = tostring(Properties["status_code"])
| order by Requests desc

// 2b. The same, request by request. Each row is one request: the PTU said 429, the spillover deployment answered with 200.
AppTraces
| where TimeGenerated > ago(10m)
| where Message == "routing-attempt-complete"
| where tostring(Properties["client_request_id"]) startswith "spill-"
| project
    TimeGenerated,
    RequestId = tostring(Properties["client_request_id"]),
    Backend = extract(@"(route-backend-\d)", 1, tostring(Properties["request_host"])),
    PtuDeployment = tostring(Properties["spillover_from"]),
    PtuReturnedStatus = tostring(Properties["spillover_error"]),
    AnsweredBy = tostring(Properties["served_deployment"]),
    StatusReturnedToCaller = tostring(Properties["status_code"]),
    Attempt = toint(Properties["attempt"])
| order by TimeGenerated asc
| take 50

// 3a. APIM did nothing: every request was a single attempt. No retry, no second backend.
//     (Each APIM attempt at a backend writes one trace row, so one row per request means one attempt.)
AppTraces
| where TimeGenerated > ago(10m)
| where Message == "routing-attempt-complete"
| where tostring(Properties["client_request_id"]) startswith "spill-"
| summarize AttemptsPerRequest = count() by RequestId = tostring(Properties["client_request_id"])
| summarize Requests = count() by AttemptsPerRequest

// 3b. APIM did nothing: APIM's own dependency telemetry for the same requests. One backend call each, all 200,
//     and no 429. APIM never learned that the PTU was exhausted.
//     NoResponse counts calls that never completed, for example a client that gave up waiting. It is rare and unrelated
//     to spillover, but it explains why BackendCalls can be slightly higher than the number of traced requests.
let spillOperations = AppTraces
    | where TimeGenerated > ago(10m)
    | where Message == "routing-request-start"
    | where tostring(Properties["client_request_id"]) startswith "spill-"
    | distinct OperationId;
AppDependencies
| where TimeGenerated > ago(10m)
| where OperationId in (spillOperations)
| summarize
    BackendCalls = count(),
    Http200 = countif(ResultCode == "200"),
    Http429 = countif(ResultCode == "429"),
    Http5xx = countif(toint(ResultCode) >= 500),
    NoResponse = countif(isempty(ResultCode))
    by Backend = extract(@"(route-backend-\d)", 1, Target)

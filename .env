LEGACY_FOUNDRY_LOCATION=eastus2
LEGACY_AOAI_DEPLOYMENT=legacy-gpt-4o
LEGACY_AOAI_MODEL=gpt-4o
LEGACY_AOAI_MODEL_VERSION=2024-11-20
